# Kopiere diese Datei nach `server/.env` und trage deine Keys ein.
# Ohne Keys laufen die externen Scans im Mock-Modus (Demo-Daten).

# HaveIBeenPwned — https://haveibeenpwned.com/API/Key  (Leak-Scan / Feature A)
HIBP_API_KEY=

# SerpAPI — https://serpapi.com/manage-api-key  (Bild-/Account-Monitoring / Feature B)
SERPAPI_KEY=

# Cache-Lebensdauer für externe Antworten in Stunden (spart Quota). Standard: 24
EXTERNAL_CACHE_TTL_H=24
